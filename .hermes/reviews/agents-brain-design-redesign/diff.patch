+  background:
+    radial-gradient(480px 180px at 84% 18%, rgba(13,10,10,0.055), transparent 66%),
+    radial-gradient(340px 140px at 18% 9%, var(--code-seal-wash), transparent 70%),
+    linear-gradient(180deg, var(--code-paper) 0%, var(--code-paper) 58%, var(--code-soft-paper) 100%);
