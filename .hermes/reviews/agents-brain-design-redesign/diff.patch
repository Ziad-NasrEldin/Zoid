+  --code-seal-wash: rgba(194, 58, 46, 0.12);
+  --code-serif-latin: trajan-pro-3, "Times New Roman", "Baskerville", "Georgia", serif;
+  --code-serif-body: source-han-serif-japanese, "Hiragino Mincho ProN", "Yu Mincho", "Times New Roman", Georgia, serif;
+  position: relative;
+  isolation: isolate;
+  height: 100vh;
+  min-width: 0;
+  min-height: 0;
+  overflow-x: hidden;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-color: var(--code-seal) rgba(13, 10, 10, 0.08);
+  scrollbar-gutter: stable;
+  scrollbar-width: thin;
+  display: grid;
+  grid-template-rows: auto auto auto;
+  grid-auto-rows: auto;
+  align-content: start;
+  gap: clamp(18px, 2.8vw, 34px);
+  padding: clamp(28px, 4.8vw, 68px) clamp(20px, 4vw, 64px) 56px;
