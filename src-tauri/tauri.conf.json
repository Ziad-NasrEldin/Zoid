{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoid 25",
  "version": "0.25.0",
  "identifier": "com.mavoid.zoid25",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zoid 25",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Clean macOS desktop scaffold for Zoid 25",
    "longDescription": "Zoid 25 is a clean macOS desktop scaffold with only the navigation sidebar and an empty workspace canvas.",
    "copyright": "Copyright \u00a9 2026 Zoid contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "minimumSystemVersion": "12.0"
    }
  }
}
