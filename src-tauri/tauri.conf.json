{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoid",
  "version": "0.1.0",
  "identifier": "com.mavoid.zoid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zoid",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first AI workbench",
    "longDescription": "Zoid is a local-first macOS workbench for tasks, notes, files, browser captures, agent runs, and review evidence.",
    "copyright": "Copyright © 2026 Zoid contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "minimumSystemVersion": "12.0"
    }
  }
}
