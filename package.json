{
  "name": "zoid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "tsx src/todayFoundation.test.ts && tsx src/settingsStatus.test.ts && tsx src/confirmationPolicy.test.ts",
    "verify:local": "scripts/verify-local.sh --skip-package",
    "verify:release": "scripts/verify-local.sh",
    "verify:push": "scripts/verify-local.sh --skip-package",
    "hooks:install": "scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
