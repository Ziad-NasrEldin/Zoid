{
  "name": "Zoid 25 Sumi-e Command System",
  "sourceOfTruth": {
    "page": "Agents / Hermes Agents",
    "component": "src/agents/AgentsHermesScreen.tsx",
    "rootClass": "hermes-chat-shell hermes-genm agents-sumi-e",
    "css": "src/App.css .agents-sumi-e plus root --sumi-* and motion tokens",
    "note": "Yellow artifacts are explicitly excluded from the extracted system."
  },
  "tokens": {
    "colors": {
      "sumiInk": "#0D0A0A",
      "sumiPaper": "#FFFFFF",
      "sumiSoftPaper": "#FAFAFA",
      "sumiMist": "#F5F5F5",
      "sumiRule": "#E0E0E0",
      "sumiPaleRule": "#EDEDED",
      "sumiMuted": "#545554",
      "sumiWash": "#F7F5F4",
      "sumiSeal": "#C23A2E",
      "sumiSealDeep": "#8F211A",
      "sumiSealWash": "#F5E5E3",
      "sumiOkay": "#2F3A2F",
      "sumiWarnLegacyOnly": "#8F5A1A"
    },
    "forbiddenVisibleColors": [
      "#FDE863",
      "yellow focus rings",
      "amber command chips",
      "orange warning cards",
      "yellowed parchment panels"
    ],
    "fonts": {
      "latin": "trajan-pro-3, Times New Roman, Baskerville, Georgia, serif",
      "bodyJapanese": "source-han-serif-japanese, Hiragino Mincho ProN, Yu Mincho, Times New Roman, Georgia, serif"
    },
    "motion": {
      "instant": "80ms",
      "micro": "120ms",
      "control": "160ms",
      "row": "220ms",
      "panel": "380ms",
      "structural": "540ms",
      "page": "760ms",
      "easeEditorial": "cubic-bezier(0.16, 1, 0.3, 1)",
