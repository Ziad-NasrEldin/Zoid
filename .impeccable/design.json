      "liftOffset": "-1px",
      "paperShadow": "4px 4px 0 rgba(13, 10, 10, 0.14)"
    }
  },
  "layout": {
    "shellRows": "auto minmax(0, 1fr) auto",
    "workspaceColumns": "var(--sessions-rail-width, 184px) minmax(0, 1fr)",
    "workspaceWithFileManager": "var(--sessions-rail-width, 184px) minmax(0, 1fr) minmax(0, var(--file-manager-width, 336px))",
    "sessionsRail": {
      "compact": 68,
      "default": 184,
      "min": 124,
      "max": 420
    },
    "fileManager": {
      "default": 336,
      "min": 240,
      "max": 520
    },
    "agentGrid": [
      "single",
      "split-2",
      "quad",
      "focus-stack",
      "count-3 hero + stack"
    ],
    "rules": [
      "fixed shell",
      "page-region scroll ownership",
      "min-width:0/min-height:0 on grid children",
      "dropdowns above decorative rules"
    ]
  },
  "componentVocabulary": [
    "compact bilingual topbar",
    "connection panel",
    "repository dropdown control",
    "file manager toggle/sidebar",
    "resizable sessions rail",
    "session portrait row",
    "agent monitor bar",
    "multi-panel agent dashboard",
    "chat stage",
    "paper message bubble",
    "boxed composer",
    "stats footer with Tune control",
    "native command panel",
    "branded confirmation dialog"
